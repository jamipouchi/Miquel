---
import '../styles/global.css';
import CommonHead from '../components/CommonHead.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import ModelContextTools from '../components/ModelContextTools.astro';
import SiteTree from '../components/SiteTree.astro';
import { getSiteTree } from '../lib/siteTree';

import Content from '../content/pages/index.md';

// Root of the whole site tree, rendered in full below the welcome text.
const root = await getSiteTree();
---

<html lang="en">
  <head>
    <CommonHead title="Home" />
  </head>
  <body>
    <article class="prose home">
      <div class="page-body">
        <Content />
      </div>
      <section id="site-tree" class="site-tree-section" aria-labelledby="site-tree-title">
        <p class="micro-label">Site tree</p>
        <h2 id="site-tree-title">The whole tree</h2>
        <p class="site-tree-intro">
          Everything on this site is a page in a tree: broader topics near the
          root, specifics deeper down. The path of a page is part of its meaning.
          <a href="/meta/">Meta explains why</a>.
        </p>
        <ul class="tree-root">
          <SiteTree node={root} currentSlug="" />
        </ul>
      </section>
      <Footer currentSlug="index" path="/" skipComments/>
    </article>
    <SearchModal />
    <ModelContextTools />

    <style>
      .prose.home h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Site tree — the whole site as one visible, static structure. */
      .site-tree-section {
        margin-top: 3.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid #e0e0e0;
      }

      .prose.home .site-tree-section h2 {
        margin-top: 0.25rem;
        margin-bottom: 0.75rem;
      }

      .site-tree-intro {
        font-size: 0.95rem;
        line-height: 1.7;
        color: #555;
        max-width: 62ch;
        margin: 0 0 2rem;
      }

      .tree-root {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.95rem;
      }

      @media (max-width: 640px) {
        .prose.home h1 {
          font-size: 2.25rem;
        }
      }
    </style>
  </body>
</html>
