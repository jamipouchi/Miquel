---
import { getBreadcrumb, getChildren, getTitleMap } from '../lib/siteTree';

interface Props {
  path: string;
}
const { path } = Astro.props;

const baseUrl = import.meta.env.DEV ? 'http://localhost:8787' : 'https://api.miquelpuigturon.com';

type ScopeKind = 'all' | 'branch' | 'article';

interface ScopeOption {
  /** Path POSTed to /subscribe; '/' means the whole site. */
  value: string;
  /** Human label shown in the picker, e.g. "Humanity → Temporal". */
  label: string;
  kind: ScopeKind;
}

const EVERYTHING_LABEL = 'Everything — the whole site';
const EVERYTHING_LINE = "You'll be emailed when anything on the site is added or significantly updated.";

// Subscription paths carry no trailing slash ('/' = the whole site).
const cleanPath = path.replace(/\/+$/, '');

// Default scope is always Everything; narrower options follow.
const scopeOptions: ScopeOption[] = [{ value: '/', label: EVERYTHING_LABEL, kind: 'all' }];

if (cleanPath !== '') {
  const segments = cleanPath.slice(1).split('/');
  const crumbs = await getBreadcrumb(cleanPath); // [] when the path isn't in the tree
  const titles = await getTitleMap();
  const known = crumbs.length > 0 && crumbs[crumbs.length - 1].path === cleanPath;

  // One option per ancestor branch; labels accumulate with ' → ' separators.
  const ancestorTitles: string[] = [];
  for (let i = 0; i < segments.length - 1; i++) {
    const slug = segments.slice(0, i + 1).join('/');
    const title = crumbs.find((crumb) => crumb.path === '/' + slug)?.title ?? titles.get(slug);
    if (!title) break; // prefix isn't a real page; stop narrowing there
    ancestorTitles.push(title);
    scopeOptions.push({ value: '/' + slug, label: ancestorTitles.join(' → '), kind: 'branch' });
  }

  if (known) {
    const selfTitle = crumbs[crumbs.length - 1].title;
    if (ancestorTitles.length === 0) {
      // Top-level section page: Everything + that section.
      scopeOptions.push({ value: cleanPath, label: selfTitle, kind: 'branch' });
    } else {
      const isLeaf = (await getChildren(cleanPath)).length === 0;
      scopeOptions.push(
        isLeaf
          ? { value: cleanPath, label: 'Just this article', kind: 'article' }
          : { value: cleanPath, label: [...ancestorTitles, selfTitle].join(' → '), kind: 'branch' }
      );
    }
  } else {
    // Path unknown to the tree (e.g. 404): the whole site or just this URL.
    scopeOptions.push({ value: cleanPath, label: 'Just this page', kind: 'article' });
  }
}

// Single scope (home): plain form, no selector.
const isSingleScope = scopeOptions.length === 1;
---

<div class="subscribe-container">
  <div class="subscribe-header">
    <h3 class="micro-label">Subscribe</h3>
    <button
      type="button"
      class="help-button"
      id="subscribe-help"
      aria-label="How subscriptions work"
      aria-haspopup="dialog"
      title="How subscriptions work"
    >
      ?
    </button>
  </div>

  {
    isSingleScope ? (
      <p class="scope-line" id="subscribe-scope-line">
        {EVERYTHING_LINE}
      </p>
    ) : (
      <div class="scope-picker">
        <label class="visually-hidden" for="subscribe-scope">
          What to subscribe to
        </label>
        <select id="subscribe-scope" class="scope-select" aria-describedby="subscribe-scope-line">
          {scopeOptions.map((option) => (
            <option value={option.value} data-kind={option.kind} data-label={option.label} selected={option.value === '/'}>
              {option.label}
            </option>
          ))}
        </select>
        <p class="scope-line" id="subscribe-scope-line">
          {EVERYTHING_LINE}
        </p>
      </div>
    )
  }

  <form id="subscribe-form" class="subscribe-form" method="post" data-base-url={baseUrl}>
    <input
      type="email"
      id="subscribe-email"
      name="email"
      placeholder="your@email.com"
      required
      autocomplete="email"
      aria-label="Email address"
      class="email-input"
    />
    <button type="submit" id="subscribe-button" class="subscribe-button">Subscribe to everything</button>
  </form>

  <p class="rss-line">
    Prefer a feed? Everything, in full, <a href="/rss.xml">via RSS</a>.
  </p>

  <div id="subscribe-message" class="subscribe-message message" role="alert"></div>
</div>

<!-- Modal -->
<div
  id="subscribe-modal"
  class="subscribe-modal modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="subscribe-modal-title"
  aria-hidden="true"
>
  <div class="modal-overlay" id="subscribe-modal-overlay"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="subscribe-modal-title">How subscriptions work</h2>
      <button type="button" class="modal-close" id="subscribe-modal-close" aria-label="Close dialog">&times;</button>
    </div>

    <div class="modal-body">
      <section>
        <h3>What you'll get</h3>
        <p>One email when content in your chosen scope is added or significantly updated. Nothing else.</p>
        <p>
          Prefer a feed reader? The same everything, in full, is always at <code>/rss.xml</code>.
        </p>
      </section>

      <section>
        <h3>Scope</h3>
        <p>
          <strong>Everything</strong> (the whole site) is the default. You can narrow to a single branch — e.g.
          Humanity → Temporal — or to a single article. A branch covers that page and everything under it.
          To subscribe to a different branch, open any page inside it — the options follow where you are.
        </p>
      </section>

      <section>
        <h3>Multiple subscriptions</h3>
        <p>Subscribe the same email to as many scopes as you like.</p>
      </section>

      <section>
        <h3>Privacy &amp; storage</h3>
        <p>Your email is stored encrypted (AES-GCM) in a Cloudflare D1 database and is only used to send these notifications.</p>
      </section>

      <section>
        <h3>Unsubscribing</h3>
        <p>Email <a href="mailto:miquel@miquelpuigturon.com">miquel@miquelpuigturon.com</a> and you'll be removed.</p>
      </section>
    </div>
  </div>
</div>

<style>
  .subscribe-container {
    margin: 0;
    padding: 0;
  }

  .subscribe-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .micro-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
  }

  .help-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    background: transparent;
    color: #0066cc;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .help-button:hover {
    border-color: #0066cc;
    background-color: rgba(0, 102, 204, 0.06);
  }

  .help-button:focus-visible {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  .scope-picker {
    margin-bottom: 0.25rem;
  }

  .scope-select {
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    background-color: #fff;
    font-family: inherit;
    font-size: 0.9rem;
    color: #1a1a1a;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .scope-select:hover {
    border-color: #d0d0d0;
  }

  .scope-select:focus-visible {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  .scope-line {
    margin: 0.4rem 0 0.75rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #666;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Quiet RSS discoverability line, styled like the scope/hint text. */
  .rss-line {
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #666;
  }

  .rss-line a {
    color: #0066cc;
  }

  .rss-line a:hover {
    color: #0052a3;
  }

  .subscribe-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: nowrap;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 4px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .subscribe-form:focus-within {
    border-color: #0066cc;
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.08);
  }

  .email-input {
    flex: 1;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.95rem;
    color: #1a1a1a;
  }

  .email-input::placeholder {
    color: #999;
  }

  .email-input:focus {
    outline: none;
  }

  .email-input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .subscribe-button {
    padding: 0.55rem 1.1rem;
    background-color: #0066cc;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
  }

  .subscribe-button:hover:not(:disabled) {
    background-color: #0052a3;
  }

  .subscribe-button:active:not(:disabled) {
    transform: scale(0.98);
  }

  .subscribe-button:focus-visible {
    outline: 2px solid #0052a3;
    outline-offset: 2px;
  }

  .subscribe-button:disabled {
    background-color: #6c757d;
    cursor: not-allowed;
  }

  .message {
    margin-top: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 4px;
    font-size: 0.85rem;
    display: none;
    line-height: 1.5;
    white-space: pre-line;
  }

  .message.show {
    display: block;
  }

  .message.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .message.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
  }

  .modal.show {
    display: block;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    max-width: 560px;
    width: 90%;
    max-height: 85vh;
    overflow-y: auto;
    animation: modalSlideIn 0.2s ease-out;
  }

  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translate(-50%, -47%);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.75rem;
    border-bottom: 1px solid #e0e0e0;
    position: sticky;
    top: 0;
    background: #fff;
    border-radius: 8px 8px 0 0;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: #000;
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    color: #666;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background-color 0.2s, color 0.2s;
  }

  .modal-close:hover {
    background-color: #f0f0f0;
    color: #000;
  }

  .modal-close:focus-visible {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  .modal-body {
    padding: 1.75rem;
  }

  .modal-body section {
    margin-bottom: 1.5rem;
  }

  .modal-body section:last-child {
    margin-bottom: 0;
  }

  .modal-body h3 {
    margin: 0 0 0.4rem 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #555;
  }

  .modal-body p {
    margin: 0;
    line-height: 1.6;
    color: #444;
  }

  .modal-body section p + p {
    margin-top: 0.4rem;
  }

  .modal-body code {
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.85em;
    background: #f4f4f4;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
  }

  .modal-body strong {
    font-weight: 600;
    color: #1a1a1a;
  }

  @media (max-width: 640px) {
    .subscribe-form {
      flex-direction: column;
      padding: 6px;
    }

    .email-input {
      padding: 0.7rem;
    }

    .subscribe-button {
      width: 100%;
      padding: 0.7rem 1.1rem;
    }

    .modal-content {
      width: 95%;
      max-height: 90vh;
    }

    .modal-header {
      padding: 1.1rem 1.4rem;
    }

    .modal-body {
      padding: 1.4rem;
    }
  }
</style>

  <script is:inline>
    // Same background-inert technique SearchModal uses while its dialog is
    // open, adapted for this modal's nested position (it is not a direct
    // child of <body>): walk the modal's ancestor chain and inert every
    // off-chain sibling subtree, so the backdrop is inert without inerting
    // the modal itself (inert inherits).
    function setBackdropInert(modal, on) {
      var node = modal;
      while (node && node !== document.body) {
        var parent = node.parentElement;
        if (!parent) break;
        Array.prototype.forEach.call(parent.children, function (sibling) {
          if (sibling === node) return;
          if (on) sibling.setAttribute('inert', '');
          else sibling.removeAttribute('inert');
        });
        node = parent;
      }
    }

    // Resolves the modal at call time (the DOM is fresh after each view
    // transition). Restores focus to the '?' trigger on close.
    function closeSubscribeModal() {
      var modal = document.getElementById('subscribe-modal');
      if (!modal || !modal.classList.contains('show')) return;
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setBackdropInert(modal, false);
      var trigger = document.getElementById('subscribe-help');
      if (trigger) trigger.focus();
    }

    // Escape closes the help modal. Bound exactly once per session: this
    // inline script re-runs on every page, so an unguarded document-level
    // listener would accumulate across view transitions.
    if (!window.__subscribeEscapeBound) {
      window.__subscribeEscapeBound = true;
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        closeSubscribeModal();
      });
    }

    const initSubscribeForm = () => {
    const form = document.getElementById('subscribe-form');
    const emailInput = document.getElementById('subscribe-email');
    const submitButton = document.getElementById('subscribe-button');
    const messageDiv = document.getElementById('subscribe-message');
    const scopeSelect = document.getElementById('subscribe-scope');
    const scopeLine = document.getElementById('subscribe-scope-line');
    const modal = document.getElementById('subscribe-modal');
    const helpButton = document.getElementById('subscribe-help');
    const modalClose = document.getElementById('subscribe-modal-close');
    const modalOverlay = document.getElementById('subscribe-modal-overlay');

    if (!form || !emailInput || !submitButton || !messageDiv || !modal || !helpButton || !modalClose || !modalOverlay) return;

    // Prevent reinitialization - check if already initialized
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    // Ensure modal is hidden initially
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');

    const BUTTON_LABELS = {
      all: 'Subscribe to everything',
      branch: 'Subscribe to this branch',
      article: 'Subscribe to this article'
    };

    function currentScope() {
      if (!scopeSelect || scopeSelect.selectedIndex < 0) {
        // Single-scope UI (home) or nothing picked yet: default is everything.
        return { value: '/', kind: 'all', label: 'Everything — the whole site' };
      }
      const option = scopeSelect.options[scopeSelect.selectedIndex];
      return {
        value: option.value,
        kind: option.dataset.kind || 'branch',
        label: option.dataset.label || option.textContent || option.value
      };
    }

    function scopeLineText(scope) {
      if (scope.kind === 'article') {
        return "You'll be emailed when this article is added or significantly updated.";
      }
      if (scope.kind === 'branch') {
        return "You'll be emailed when anything under " + scope.label + ' is added or significantly updated.';
      }
      return "You'll be emailed when anything on the site is added or significantly updated.";
    }

    function updateScopeUI() {
      const scope = currentScope();
      submitButton.textContent = BUTTON_LABELS[scope.kind] || BUTTON_LABELS.all;
      if (scopeLine) scopeLine.textContent = scopeLineText(scope);
    }

    if (scopeSelect) scopeSelect.addEventListener('change', updateScopeUI);
    updateScopeUI();

    function showMessage(text, type) {
      messageDiv.textContent = text;
      messageDiv.className = 'subscribe-message message show ' + type;
      if (type === 'success') setTimeout(() => messageDiv.classList.remove('show'), 5000);
    }

    function openModal() {
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setBackdropInert(modal, true);
      // Move focus into the dialog (SearchModal pattern).
      modalClose.focus();
    }

    helpButton.addEventListener('click', openModal);
    modalClose.addEventListener('click', closeSubscribeModal);
    modalOverlay.addEventListener('click', closeSubscribeModal);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const scope = currentScope();
      const baseUrl = form.dataset.baseUrl;

      if (!email) {
        showMessage('Please enter your email address', 'error');
        return;
      }

      if (!scope.value) {
        showMessage('Please choose what to subscribe to', 'error');
        return;
      }

      // Pending pattern: disable + relabel only (no spinners, no layout shift).
      emailInput.disabled = true;
      if (scopeSelect) scopeSelect.disabled = true;
      submitButton.disabled = true;
      submitButton.textContent = 'Subscribing…';

      try {
        const res = await fetch(baseUrl + '/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, path: scope.value })
        });
        const data = await res.json();

        if (res.ok) {
          // Restate the chosen scope in the first line of the success state.
          const restated = scope.kind === 'article' ? 'just this article' : scope.label;
          const lines = ["You're subscribed to " + restated + '.'];
          if (data.message) lines.push(data.message);
          showMessage(lines.join('\n'), 'success');
          emailInput.value = '';
        } else {
          showMessage(data.error || 'Failed to subscribe. Please try again.', 'error');
        }
      } catch {
        showMessage('An error occurred. Please try again later.', 'error');
      } finally {
        emailInput.disabled = false;
        if (scopeSelect) scopeSelect.disabled = false;
        updateScopeUI();
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSubscribeForm);
  } else {
    initSubscribeForm();
  }

  document.addEventListener('astro:page-load', initSubscribeForm);
</script>
