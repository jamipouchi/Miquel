---
import { getSiteTree, type SiteNode } from '../lib/siteTree';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const root = await getSiteTree();

// 'index' (home) normalizes to ''; paths with slashes are accepted too.
const normalizedSlug = currentSlug === 'index' ? '' : currentSlug.replace(/^\/+|\/+$/g, '');

function findBySlug(node: SiteNode, slug: string): SiteNode | undefined {
  if (node.slug === slug) return node;
  for (const child of node.children) {
    const hit = findBySlug(child, slug);
    if (hit) return hit;
  }
  return undefined;
}

// Unknown slug: fall back to the home view of the tree.
const current = findBySlug(root, normalizedSlug) ?? root;
const isMetaPage = current.section === 'meta';

interface NavNode {
  node: SiteNode;
  level: number;
  isCurrent: boolean;
  isAncestor: boolean;
}

// HOME, then ancestors -> siblings (current in its natural alphabetical
// position) -> children of the current page. Titles come from the h1 of each
// page via siteTree.
const nodes: NavNode[] = [];
nodes.push({
  node: root,
  level: 0,
  isCurrent: current === root,
  isAncestor: current !== root,
});

if (current === root) {
  // At home: top-level sections, meta excluded (it lives isolated on /meta/*).
  for (const child of root.children) {
    if (child.section === 'meta') continue;
    nodes.push({ node: child, level: 1, isCurrent: false, isAncestor: false });
  }
} else {
  // Ancestors of the current page, root-first, home itself excluded.
  const ancestors: SiteNode[] = [];
  for (let p = current.parent; p && p.parent; p = p.parent) ancestors.unshift(p);
  ancestors.forEach((ancestor, i) => {
    nodes.push({ node: ancestor, level: i + 1, isCurrent: false, isAncestor: true });
  });

  // Siblings: the parent's children in stable alphabetical (tree) order — the
  // current page stays in its natural position. Meta filtering only applies at
  // the top level, matching the site-wide meta isolation.
  const parent = current.parent ?? root;
  let siblings = parent.children;
  if (!parent.parent) {
    siblings = siblings.filter((n) =>
      isMetaPage ? n.section === 'meta' : n.section !== 'meta',
    );
  }

  const siblingLevel = ancestors.length + 1;
  for (const sibling of siblings) {
    nodes.push({
      node: sibling,
      level: siblingLevel,
      isCurrent: sibling === current,
      isAncestor: false,
    });

    // Children nest directly under the current page.
    if (sibling === current) {
      for (const child of current.children) {
        nodes.push({ node: child, level: siblingLevel + 1, isCurrent: false, isAncestor: false });
      }
    }
  }
}

const hrefFor = (node: SiteNode): string => (node.slug === '' ? '/' : `${node.path}/`);
// The root keeps its all-caps HOME label (AGENTS.MD convention); every other
// node uses its real h1-derived title.
const labelFor = (node: SiteNode): string => (node.slug === '' ? 'HOME' : node.title);
const vtNameFor = (node: SiteNode): string =>
  `nav-${node.slug.replace(/[^a-z0-9]+/gi, '-')}`;
---

<nav class="tree-nav" class:list={{ 'meta-nav': isMetaPage }} aria-label="Site tree">
  <div class="tree-nav-head">
    <p class="micro-label">You are here</p>
    {current.depth > 0 && (
      <a class="tree-full-link" href="/#site-tree">Full tree ↑</a>
    )}
  </div>
  <p class="tree-help">The current page among its siblings and children.</p>
  <ul class="tree-list">
    {nodes.map(({ node, level, isCurrent, isAncestor }) => (
      <li
        class:list={['tree-item', { current: isCurrent, ancestor: isAncestor }]}
        style={`--indent: ${level}; view-transition-name: ${vtNameFor(node)};`}
      >
        <a
          href={hrefFor(node)}
          title={node.title}
          aria-current={isCurrent ? 'page' : undefined}
        >
          {labelFor(node)}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tree-nav {
    margin: 0;
    /* Grid child (footer columns): without this, the nowrap labels' min
       width would inflate the grid track past the viewport. */
    min-width: 0;
  }

  .tree-nav-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .tree-full-link {
    font-size: 0.75rem;
    color: #0066cc;
    white-space: nowrap;
  }

  .tree-full-link:hover {
    color: #0052a3;
  }

  .tree-help {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #666;
    margin: 0 0 0.75rem;
  }

  .tree-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 0.9rem;
  }

  .tree-item {
    position: relative;
    margin: 0;
    /* 0.75rem base leaves room for the current-page rule at every depth. */
    padding: 0.35rem 0;
    padding-left: calc(0.75rem + var(--indent) * 1.5rem);
    transition: all 0.3s ease;
  }

  .tree-item a {
    display: block;
    color: #666;
    text-decoration: none;
    transition: color 0.2s ease;
    /* Graceful truncation; the full title stays in the title attribute. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tree-item a:hover {
    color: #0066cc;
    text-decoration: none;
  }

  .tree-item.ancestor a {
    color: #333;
    font-weight: 500;
  }

  .tree-item.current a {
    color: #0066cc;
    font-weight: 600;
  }

  /* Visible marker for the current page: a short rule left of the label. */
  .tree-item.current::before {
    content: '';
    position: absolute;
    left: calc(var(--indent) * 1.5rem);
    top: 0.45rem;
    bottom: 0.45rem;
    width: 2px;
    border-radius: 1px;
    background: #0066cc;
  }

  /* Special styling for meta pages */
  .tree-nav.meta-nav .tree-item a {
    color: #7c3aed;  /* Purple for meta pages */
  }

  .tree-nav.meta-nav .tree-item a:hover {
    color: #6d28d9;  /* Darker purple on hover */
  }

  .tree-nav.meta-nav .tree-item.current a {
    color: #6d28d9;
    font-weight: 600;
  }

  .tree-nav.meta-nav .tree-item.current::before {
    background: #7c3aed;
  }

  .tree-nav.meta-nav .tree-item.ancestor a {
    color: #7c3aed;
    font-weight: 500;
  }

  .tree-nav.meta-nav .tree-full-link {
    color: #7c3aed;
  }

  .tree-nav.meta-nav .tree-full-link:hover {
    color: #6d28d9;
  }

  /* Mobile: single-line ellipsis becomes wrap, so nothing forces the page
     wider than the viewport. Above this breakpoint the ellipsis stays. */
  @media (max-width: 767px) {
    .tree-item a {
      white-space: normal;
      overflow-wrap: break-word;
    }
  }

  /* Touch targets: ~30px tall links are hard to hit on phones. */
  @media (max-width: 767px), (pointer: coarse) {
    .tree-item a {
      min-height: 40px;
      display: flex;
      align-items: center;
    }
  }
</style>
