{
  "extends": "astro/tsconfigs/strict",
  // .cloudflare/types/index.d.ts is generated by `cf workers types` (run by
  // `npm run check`/`npm run types`, and by `cf dev`): Workers runtime types
  // plus `Env`, inferred from the bindings in cloudflare.config.ts.
  "include": [".astro/types.d.ts", ".cloudflare/types/index.d.ts", "**/*"],
  "exclude": ["dist", ".cloudflare/output", ".cloudflare/state"]
}
