---
import { getCollection, render } from 'astro:content';
import '../styles/global.css';
import CommonHead from '../components/CommonHead.astro';
import Footer from '../components/Footer.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SearchModal from '../components/SearchModal.astro';
import ModelContextTools from '../components/ModelContextTools.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getTitleMap } from '../lib/siteTree';

// Static page, built at build time (see integrations/static-pages-only.mjs).
export const prerender = true;

export async function getStaticPaths() {
  const allPages = await getCollection('pages');

  // The root entry (id 'index') is owned by src/pages/index.astro, which
  // renders '/'. Emitting it here too would produce a ghost '/index/' page
  // with its own canonical pointing at itself.
  const paths = allPages
    .filter(page => page.id !== 'index')
    .map(page => ({
      params: { slug: page.id },
      props: { page }
    }));

  return paths;
}

const { page } = Astro.props;
const { Content, headings } = await render(page);

// Titles unify on siteTree (same first-h1 rule, inline markdown stripped),
// so <title>/og:title can never diverge from navigation labels — e.g. a
// raw `headings` text would keep italics markup where siteTree strips it.
const title = (await getTitleMap()).get(page.id)
  ?? headings.find(h => h.depth === 1)?.text
  ?? page.id.split('/').pop()!;
const path = '/' + page.id;
---

<html lang="en">
  <head>
    <CommonHead title={title} ogType="article" />
  </head>
  <body class="with-toc">
    <TableOfContents headings={headings} />
    <Breadcrumbs path={path} title={title} />
    <article class="prose">
      <div class="page-body">
        <Content />
      </div>
      <Footer currentSlug={page.id} path={path} />
    </article>
    <SearchModal />
    <ModelContextTools />
  </body>
</html>
